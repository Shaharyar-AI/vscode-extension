{
  "name": "cr-track-engine",
  "version": "0.1.0",
  "private": true,
  "description": "CR-Track review engine — drives the local Claude CLI over a git diff and returns structured findings. Phase 0: standalone, no VS Code.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "cr-track": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.json && node dist/selftest.js",
    "review": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "22",
    "typescript": "5"
  }
}
