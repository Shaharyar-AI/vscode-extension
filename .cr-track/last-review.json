      "file": "extension/src/extension.ts",
      "lineStart": 398,
      "lineEnd": 400,
      "severity": "important",
      "category": "correctness",
      "title": "Staged review discards the previous review without finalizing it",
      "description": "Clearing `this.pushed` here drops the last commit's pushed review outright, unlike `reviewCommit`, which calls `finalizePrevious()` (line 431) to send the final applied/total counts first. After running a staged review, that commit's review is never finalized: `scheduleRepush` and the next commit's `finalizePrevious()` both return early at `if (!this.pushed) return;`, so any fixes the developer ticked off for it are never reported and the review stays unscored on the dashboard.",
      "suggestion": "Consider calling `this.finalizePrevious()` instead — it pushes the final outcome and then clears `this.pushed`, so the staged review still pushes nothing of its own.",
      "confidence": 0.85,
      "hadPatch": true,
